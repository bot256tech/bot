<!-- Admin: live PostgreSQL view -->
<%
  var counts = data.counts || [];
  var passports = data.passports || [];
  var telemetry = data.telemetry || [];
  var roles = data.roles || [];
  var totalRows = counts.reduce(function(s,c){ return s + (c.rows||0); },0);
%>

<div style="display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:12px;margin-bottom:22px">
  <div>
    <h2 style="font-weight:800;margin-bottom:4px">Database — Live View</h2>
    <div style="color:var(--tx2);font-size:.9rem">
      <%= data.version %> · database size <strong><%= data.size %></strong> · <%= counts.length %> tables · <%= totalRows.toLocaleString() %> rows total — read directly from PostgreSQL
    </div>
  </div>
  <a href="/admin-dashboard" class="btn btn-o btn-sm"><i class="fas fa-arrow-left"></i> Admin Dashboard</a>
</div>

<!-- Table row counts -->
<div class="card" style="margin-bottom:20px">
  <h3 style="font-weight:800;margin-bottom:14px"><i class="fas fa-database" style="color:var(--g)"></i> Tables &amp; row counts (live)</h3>
  <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(170px,1fr));gap:10px">
    <% counts.forEach(function(c){ %>
      <div style="background:var(--bg2);border:1px solid var(--bd);border-radius:12px;padding:12px 14px">
        <div style="font-size:1.25rem;font-weight:800;color:var(--g)"><%= c.rows === null ? '—' : c.rows.toLocaleString() %></div>
        <div style="font-size:.72rem;color:var(--tx2);font-family:ui-monospace,monospace"><%= c.table %></div>
      </div>
    <% }) %>
  </div>
  <div style="margin-top:14px;font-size:.78rem;color:var(--tx2)">
    Accounts by role:
    <% roles.forEach(function(r){ %><span class="tag tag-b" style="margin-right:6px"><%= r.role %>: <%= r.n %></span><% }) %>
  </div>
</div>

<div class="grid grid2">
  <!-- Recent passports with signatures -->
  <div class="card">
    <h3 style="font-weight:800;margin-bottom:12px"><i class="fas fa-certificate" style="color:var(--g)"></i> Latest Quality Passports</h3>
    <div class="tbl-wrap">
      <table>
        <thead><tr><th>Batch</th><th>Crop</th><th>Grade</th><th>Signed</th><th>Source</th></tr></thead>
        <tbody>
          <% passports.forEach(function(p){ %>
          <tr>
            <td style="font-family:ui-monospace,monospace;font-size:.78rem"><a href="/passport/<%= p.batch_number %>" style="color:var(--g);font-weight:700"><%= p.batch_number %></a></td>
            <td><%= p.crop_type %></td>
            <td><span class="tag <%= p.quality_grade === 'A' || p.quality_grade === 'B' ? 'tag-g' : 'tag-a' %>"><%= p.quality_grade || '—' %></span></td>
            <td><%= p.signed ? '<span class="tag tag-g">HMAC</span>' : '<span class="tag tag-a">unsigned</span>' %></td>
            <td style="font-size:.75rem;color:var(--tx2)"><%= p.record_source %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Latest telemetry with anomaly flags -->
  <div class="card">
    <h3 style="font-weight:800;margin-bottom:12px"><i class="fas fa-microchip" style="color:var(--a)"></i> Latest Dryer Telemetry</h3>
    <div class="tbl-wrap">
      <table>
        <thead><tr><th>Device</th><th>°C</th><th>RH</th><th>Moisture</th><th>Status</th></tr></thead>
        <tbody>
          <% telemetry.forEach(function(t){ %>
          <tr>
            <td style="font-family:ui-monospace,monospace;font-size:.75rem"><%= t.device_id %></td>
            <td><%= t.temperature_c %></td>
            <td><%= t.humidity_pct %>%</td>
            <td><%= t.grain_moisture_pct %>%</td>
            <td>
              <% if (t.anomaly_flag) { %>
                <span class="tag tag-r" title="<%= t.anomaly_reasons %>">Flagged</span>
              <% } else { %>
                <span class="tag tag-g">OK</span>
              <% } %>
            </td>
          </tr>
          <% }) %>
          <% if (!telemetry.length) { %>
          <tr><td colspan="5" style="color:var(--tx2);text-align:center;padding:18px">No telemetry yet — readings appear here the moment a dryer hub reports.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<div class="card" style="margin-top:20px;background:var(--bg2);border:1px dashed var(--bd)">
  <div style="font-size:.8rem;color:var(--tx2);line-height:1.6">
    <i class="fas fa-lock" style="color:var(--g)"></i>
    PostgreSQL runs on the server itself, bound to localhost only — it is never exposed to the internet.
    This page is restricted to ADMIN accounts and performs read-only queries.
  </div>
</div>

<style>
  table{width:100%;border-collapse:collapse;font-size:.82rem}
  thead th{text-align:left;padding:9px 10px;background:var(--bg2);color:var(--tx2);font-weight:700;font-size:.68rem;text-transform:uppercase;letter-spacing:.4px;white-space:nowrap}
  tbody td{padding:9px 10px;border-top:1px solid var(--bd);vertical-align:middle}
</style>
