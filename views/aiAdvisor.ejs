<!-- AGRICHAIN Decision Advisor — local rules engine, real data -->
<div class="ai-page" style="display:grid;grid-template-columns:1fr;gap:20px" id="aiPageRoot">

  <div style="display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:12px">
    <div>
      <h2 style="font-weight:800;margin-bottom:4px">Decision Advisor</h2>
      <div style="color:var(--tx2);font-size:.9rem">
        Answers generated from your stored platform records — listings, quality passports, partner and fee data
      </div>
    </div>
    <span class="tag tag-g"><i class="fas fa-circuit-board" style="margin-right:4px"></i> Local decision engine — no external AI service</span>
  </div>

  <div style="display:grid;grid-template-columns:minmax(0,2fr) minmax(240px,1fr);gap:20px;align-items:start">
    <!-- Chat -->
    <div class="card" style="padding:0;overflow:hidden;display:flex;flex-direction:column;height:560px">
      <div style="display:flex;justify-content:space-between;align-items:center;padding:14px 18px;border-bottom:1px solid var(--bd)">
        <div style="display:flex;align-items:center;gap:10px">
          <div style="width:34px;height:34px;border-radius:11px;background:var(--g);display:flex;align-items:center;justify-content:center;color:#fff">
            <i class="fas fa-compass-drafting"></i>
          </div>
          <div>
            <div style="font-weight:800;font-size:.92rem">Conversation</div>
            <div style="font-size:.72rem;color:var(--tx2)"><span style="display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--g);margin-right:5px"></span>Online</div>
          </div>
        </div>
        <button class="btn btn-o btn-sm" onclick="clearChat()"><i class="fas fa-redo"></i> New conversation</button>
      </div>

      <div id="aiChat" style="flex:1;overflow-y:auto;padding:18px;display:flex;flex-direction:column;gap:12px;background:var(--bg)">
        <div class="ai-msg" style="display:flex;gap:10px">
          <div style="width:30px;height:30px;border-radius:10px;background:var(--g);color:#fff;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:.75rem"><i class="fas fa-compass-drafting"></i></div>
          <div style="max-width:85%;background:var(--card);border:1px solid var(--bd);border-radius:4px 14px 14px 14px;padding:12px 15px;font-size:.87rem;line-height:1.55;box-shadow:var(--sh)">
            <strong>Hello<%= data.user ? ', ' + data.user.name.split(' ')[0] : '' %>.</strong> I am the AGRICHAIN Decision Advisor.
            I answer from stored platform records<%= data.user ? '' : ' — log in as a farmer for advice based on your own batches' %>.
            Try asking: <em>Can I list this coffee for sale?</em>
          </div>
        </div>
      </div>

      <div style="padding:12px 16px;border-top:1px solid var(--bd);background:var(--card)">
        <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:10px" id="aiSuggestRow">
          <button class="btn btn-o btn-sm" onclick="ask('Can I list this coffee for sale?')">Listing readiness</button>
          <button class="btn btn-o btn-sm" onclick="ask('What are current market prices?')">Market prices</button>
          <button class="btn btn-o btn-sm" onclick="ask('How much does solar drying cost?')">Drying costs</button>
          <button class="btn btn-o btn-sm" onclick="ask('Explain quality grades')">Quality grades</button>
          <button class="btn btn-o btn-sm" onclick="ask('Any disease risk in my area?')">Disease risk</button>
        </div>
        <div style="display:flex;gap:10px">
          <input type="text" id="aiInput" class="ai-text-input" placeholder="Ask about your batches, prices, quality, drying…" autocomplete="off"
                 onkeydown="if(event.key==='Enter'){event.preventDefault();ask();}">
          <button class="btn btn-p" id="aiSendBtn" onclick="ask()" style="flex-shrink:0"><i class="fas fa-paper-plane"></i> Send</button>
        </div>
        <div id="aiError" style="display:none;color:#c62828;font-size:.78rem;margin-top:8px"></div>
      </div>
    </div>

    <!-- Side info -->
    <div style="display:flex;flex-direction:column;gap:20px">
      <div class="card">
        <h3 style="font-weight:800;font-size:.95rem;margin-bottom:10px"><i class="fas fa-circle-info" style="color:var(--g)"></i> How it works</h3>
        <div style="font-size:.8rem;color:var(--tx2);line-height:1.6">
          The advisor applies documented agricultural rules to your own records:
          <ul style="margin:8px 0 8px 18px;padding:0">
            <li>Batch moisture targets per crop</li>
            <li>Aflatoxin safety thresholds</li>
            <li>Quality grading (A/B/C/rejected)</li>
            <li>Marketplace readiness checks</li>
            <li>Pilot fee schedule (drying, testing, commission)</li>
          </ul>
          Every recommendation cites the record it came from. It does not call any external AI provider.
        </div>
      </div>

      <div class="card">
        <h3 style="font-weight:800;font-size:.95rem;margin-bottom:10px"><i class="fas fa-certificate" style="color:var(--g)"></i> Grading standard</h3>
        <table style="width:100%;font-size:.78rem;border-collapse:collapse">
          <tr><td style="padding:6px 0;color:var(--tx2)">Grade A</td><td style="text-align:right;font-weight:700">≤ 13% & ≤ 5 ppb</td></tr>
          <tr><td style="padding:6px 0;color:var(--tx2)">Grade B</td><td style="text-align:right;font-weight:700">≤ 14% & ≤ 10 ppb</td></tr>
          <tr><td style="padding:6px 0;color:var(--tx2)">Grade C</td><td style="text-align:right;font-weight:700">≤ 15% & ≤ 20 ppb</td></tr>
          <tr><td style="padding:6px 0;color:var(--tx2)">Beyond limits</td><td style="text-align:right;font-weight:700;color:#c62828">Rejected</td></tr>
        </table>
        <a href="/verify" class="btn btn-o btn-sm" style="width:100%;justify-content:center;margin-top:12px"><i class="fas fa-shield-halved"></i> Verify a passport</a>
      </div>
    </div>
  </div>
</div>

<style>
  .ai-text-input{flex:1;padding:12px 16px;border:1px solid var(--bd);border-radius:14px;font-size:.9rem;background:var(--bg);color:var(--tx);outline:none}
  .ai-text-input:focus{border-color:var(--g)}
  .ai-msg-user{display:flex;gap:10px;justify-content:flex-end}
  .ai-msg-user .bubble{background:var(--g);color:#fff;border-radius:14px 4px 14px 14px;padding:12px 15px;font-size:.87rem;max-width:85%;font-weight:600}
  .ai-msg-bot{display:flex;gap:10px}
  .ai-msg-bot .bubble{background:var(--card);border:1px solid var(--bd);border-radius:4px 14px 14px 14px;padding:12px 15px;font-size:.87rem;line-height:1.55;max-width:85%;box-shadow:var(--sh)}
  .ai-msg-bot .bubble a{color:var(--g);font-weight:700}
  .typing span{display:inline-block;width:7px;height:7px;margin-right:4px;border-radius:50%;background:var(--tx2);animation:aiBlink 1.2s infinite}
  .typing span:nth-child(2){animation-delay:.2s}
  .typing span:nth-child(3){animation-delay:.4s}
  @keyframes aiBlink{0%,80%,100%{opacity:.25}40%{opacity:1}}
  @media(max-width:900px){
    #aiPageRoot > div:nth-child(2){grid-template-columns:1fr}
    #aiPageRoot .card[style*="560px"]{height:460px}
  }
</style>

<script>
var aiBusy = false;

function esc(s){var d=document.createElement('div');d.textContent=s||'';return d.innerHTML}

function scrollChat(){var c=document.getElementById('aiChat');if(c)c.scrollTop=c.scrollHeight}

function addBot(html){
  var c=document.getElementById('aiChat');
  var m=document.createElement('div');
  m.className='ai-msg-bot';
  m.innerHTML='<div style="width:30px;height:30px;border-radius:10px;background:var(--g);color:#fff;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:.75rem"><i class="fas fa-compass-drafting"></i></div>'+
              '<div class="bubble">'+html+'</div>';
  c.appendChild(m);scrollChat();
}

function addUser(text){
  var c=document.getElementById('aiChat');
  var m=document.createElement('div');
  m.className='ai-msg-user';
  m.innerHTML='<div class="bubble">'+esc(text)+'</div>';
  c.appendChild(m);scrollChat();
}

function showTyping(){
  var c=document.getElementById('aiChat');
  var m=document.createElement('div');
  m.className='ai-msg-bot';m.id='aiTyping';
  m.innerHTML='<div style="width:30px;height:30px;border-radius:10px;background:var(--g);color:#fff;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:.75rem"><i class="fas fa-compass-drafting"></i></div>'+
              '<div class="bubble typing"><span></span><span></span><span></span></div>';
  c.appendChild(m);scrollChat();
}
function hideTyping(){var t=document.getElementById('aiTyping');if(t)t.remove()}

function showError(msg){
  var e=document.getElementById('aiError');
  if(!msg){e.style.display='none';e.textContent='';return}
  e.style.display='block';e.textContent=msg;
}

function ask(preset){
  var input=document.getElementById('aiInput');
  var q=(preset||input.value||'').trim();
  if(!q){input&&input.focus();return}
  if(aiBusy)return;
  showError('');
  addUser(q);
  if(input)input.value='';
  aiBusy=true;
  var btn=document.getElementById('aiSendBtn');
  if(btn){btn.disabled=true;btn.style.opacity=.6}
  showTyping();

  fetch('/api/v1/ai/ask',{
    method:'POST',
    headers:{'Content-Type':'application/json'},
    credentials:'same-origin',
    body:JSON.stringify({question:q})
  })
  .then(function(r){if(!r.ok)throw new Error('Server error ('+r.status+')');return r.json()})
  .then(function(d){
    hideTyping();
    if(d&&d.success&&d.data&&d.data.answer){
      addBot(d.data.answer);
    }else{
      addBot('I could not process that question. Please rephrase it — for example: <em>Can I list this maize for sale?</em>');
    }
  })
  .catch(function(err){
    hideTyping();
    addBot('The advisor service is temporarily unavailable. Please check your connection and try again in a moment.');
    showError(err.message||'Network error');
  })
  .finally(function(){
    aiBusy=false;
    if(btn){btn.disabled=false;btn.style.opacity=1}
    if(input)input.focus();
  });
}

function clearChat(){
  var c=document.getElementById('aiChat');
  if(!c)return;
  c.innerHTML='';
  addUser && null;
  var m=document.createElement('div');
  m.className='ai-msg-bot';
  m.innerHTML='<div style="width:30px;height:30px;border-radius:10px;background:var(--g);color:#fff;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:.75rem"><i class="fas fa-compass-drafting"></i></div>'+
    '<div class="bubble"><strong>New conversation.</strong> Ask me anything about your batches, prices, quality or drying.</div>';
  c.appendChild(m);
  showError('');
}
</script>
