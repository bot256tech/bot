<!-- Buyer Dashboard — real data from PostgreSQL -->
<%
  var u = data.user || {};
  var products = data.products || [];
  var orders = data.orders || [];
  var pending = orders.filter(function(o){ return o.status === 'pending'; }).length;
%> <div style="display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:12px;margin-bottom:22px"> <div> <h2 style="font-weight:800;margin-bottom:4px">Buyer Dashboard</h2> <div style="color:var(--tx2);font-size:.9rem"> <% if (data.profile && data.profile.company_name) { %><%= data.profile.company_name %> · <% } %> <%= u.name %> <% if (u.phone) { %> · <%= u.phone %><% } %> </div> </div> <div style="display:flex;gap:8px;flex-wrap:wrap"> <a href="/order-history" class="btn btn-o btn-sm"><i class="fas fa-receipt"></i> Order History</a> <a href="/verify" class="btn btn-o btn-sm"><i class="fas fa-certificate"></i> Verify Passport</a> <a href="/marketplace" class="btn btn-p btn-sm"><i class="fas fa-store"></i> Full Marketplace</a> </div>
</div> <% if (data.success) { %> <div style="background:#e8f5e9;border:1px solid #4caf50;border-radius:10px;padding:12px 16px;margin-bottom:16px;font-size:.85rem;color:#1b5e20"> <i class="fas fa-check-circle"></i> <%= data.success %> </div>
<% } %>
<% if (data.error) { %> <div style="background:#fff3e0;border:1px solid #ff9800;border-radius:10px;padding:12px 16px;margin-bottom:16px;font-size:.85rem;color:#e65100"> <i class="fas fa-exclamation-circle"></i> <%= data.error %> </div>
<% } %> <!-- Quick stats -->
<div class="grid grid3" style="margin-bottom:22px"> <div class="metric"> <div class="metric-val"><%= products.length %></div> <div class="metric-lbl">Available Listings</div> <div class="metric-tr" style="color:var(--tx2)">quality information shown per batch</div> </div> <div class="metric"> <div class="metric-val" style="color:var(--a)"><%= orders.length %></div> <div class="metric-lbl">Orders Placed</div> <div class="metric-tr" style="color:var(--tx2)"><%= pending %> pending confirmation</div> </div> <div class="metric"> <div class="metric-val" style="color:var(--g)"><%= products.filter(function(p){ return p.quality_grade === 'A' || p.quality_grade === 'B'; }).length %></div> <div class="metric-lbl">Certified Batches (A/B)</div> <div class="metric-tr" style="color:var(--tx2)">with verifiable passports</div> </div>
</div> <!-- Search -->
<div class="card" style="margin-bottom:20px"> <form method="GET" action="/buyer-dashboard" style="display:flex;gap:10px;flex-wrap:wrap"> <input type="text" name="q" placeholder="Search available produce by crop or district" value="<%= data.query %>" style="flex:1;min-width:220px"> <button type="submit" class="btn btn-p btn-sm"><i class="fas fa-search"></i> Search</button> </form>
</div> <!-- Available produce -->
<div class="card" style="margin-bottom:20px"> <h3 style="font-weight:800;margin-bottom:14px">Available Produce</h3> <% if (products.length === 0) { %> <div style="text-align:center;padding:36px 20px;color:var(--tx2);font-size:.88rem"> <i class="fas fa-search" style="font-size:1.6rem;opacity:.4"></i> <div style="margin-top:10px">No listings match your search. <a href="/buyer-dashboard" style="color:var(--g);font-weight:700">Clear search</a></div> </div> <% } else { %> <div class="tbl-wrap"> <table> <thead><tr><th>Crop</th><th>Quantity</th><th>Price</th><th>Quality</th><th>Moisture</th><th>Location</th><th>Farmer</th><th>Passport</th><th></th></tr></thead> <tbody> <% products.forEach(function(p){ %> <tr> <td><strong><%= p.crop %></strong></td> <td><%= parseFloat(p.quantity).toLocaleString() %> <%= p.unit %></td> <td><strong>UGX <%= parseFloat(p.price_per_unit).toLocaleString() %></strong>/<%= p.unit %></td> <td> <% if (p.quality_status === 'APPROVED') { %><span class="tag tag-g">Approved</span><% }
               else if (p.quality_status === 'REJECTED') { %><span class="tag tag-r">Rejected</span><% }
               else { %><span class="tag tag-a">Pending</span><% } %> <% if (p.quality_grade) { %><span class="tag tag-b">Grade <%= p.quality_grade %></span><% } %> </td> <td><%= p.moisture_level != null ? p.moisture_level + '%' : '—' %></td> <td><%= p.district || '—' %></td> <td><%= p.farmer_name %></td> <td> <% if (p.batch_number) { %> <a href="/passport/<%= p.batch_number %>" class="btn btn-o btn-sm"><%= p.batch_number %></a> <% } else { %><span style="color:var(--tx2);font-size:.78rem">Not issued</span><% } %> </td> <td><a href="/product/<%= p.id %>" class="btn btn-p btn-sm">Order</a></td> </tr> <% }) %> </tbody> </table> </div> <% } %>
</div> <!-- Recent orders -->
<div class="card"> <h3 style="font-weight:800;margin-bottom:14px">Recent Orders</h3> <% if (orders.length === 0) { %> <div style="text-align:center;padding:30px;color:var(--tx2);font-size:.88rem"> You have not placed any orders yet. Open a listing to place an order request.
    </div> <% } else { %> <div class="tbl-wrap"> <table> <thead><tr><th>Date</th><th>Crop</th><th>Farmer</th><th>Quantity</th><th>Total</th><th>Status</th></tr></thead> <tbody> <% orders.slice(0, 6).forEach(function(o){ %> <tr> <td><%= new Date(o.created_at).toLocaleDateString() %></td> <td><strong><%= o.crop %></strong></td> <td><%= o.farmer_name %></td> <td><%= parseFloat(o.quantity).toLocaleString() %> <%= o.unit %></td> <td><strong>UGX <%= parseFloat(o.total_amount).toLocaleString() %></strong></td> <td> <% if (o.status === 'pending') { %><span class="tag tag-a">Pending</span> <% } else if (o.status === 'completed') { %><span class="tag tag-g">Completed</span> <% } else if (o.status === 'confirmed') { %><span class="tag tag-b">Confirmed</span> <% } else { %><span class="tag tag-r">Cancelled</span><% } %> </td> </tr> <% }) %> </tbody> </table> </div> <% if (orders.length > 6) { %><a href="/order-history" class="btn btn-o btn-sm" style="margin-top:12px">View all orders</a><% } %> <% } %>
</div> <style> table{width:100%;border-collapse:collapse;font-size:.84rem}
  thead th{text-align:left;padding:10px 12px;background:var(--bg2);color:var(--tx2);font-weight:700;font-size:.7rem;text-transform:uppercase;letter-spacing:.4px;white-space:nowrap}
  tbody td{padding:10px 12px;border-top:1px solid var(--bd);vertical-align:middle}
  tbody tr:hover{background:var(--bg2)}
  input[type=text]{padding:10px 14px;border:1px solid var(--bd);border-radius:50px;font-size:.85rem;background:var(--bg);color:var(--tx);outline:none}
</style>
