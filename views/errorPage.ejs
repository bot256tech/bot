<!-- Error / Not Found -->
<div style="max-width:520px;margin:60px auto;padding:0 16px;text-align:center"> <div class="card" style="padding:40px 28px"> <i class="fas fa-<%= data.icon || 'exclamation-triangle' %>" style="font-size:2.2rem;color:var(--tx2);opacity:.6"></i> <h2 style="font-weight:800;margin:14px 0 6px"><%= data.heading || (data.error ? 'Something went wrong' : 'Page not found') %></h2> <% if (data.error) { %> <p style="color:var(--tx2);font-size:.88rem"><%= data.error %></p> <% } else { %> <p style="color:var(--tx2);font-size:.88rem">The page you requested does not exist or has moved.</p> <% } %> <% if (data.detail) { %><p style="color:var(--tx2);font-size:.8rem"><%= data.detail %></p><% } %> <div style="display:flex;gap:10px;justify-content:center;margin-top:20px;flex-wrap:wrap"> <a href="/" class="btn btn-p"><i class="fas fa-home"></i> Home</a> <a href="/marketplace" class="btn btn-o">Marketplace</a> </div> </div>
</div>
