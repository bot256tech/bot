      <h3 style="font-weight:800;font-size:1rem;margin-bottom:6px">Your browser</h3>
      <p style="color:var(--tx2);font-size:.85rem;margin-bottom:14px">
        You can still use AGRICHAIN 360 — it works fully in any modern browser.
      </p>
      <div style="display:flex;gap:10px;flex-wrap:wrap">
        <a href="/" class="btn btn-p"><i class="fas fa-globe"></i> Open the Web App</a>
        <a href="/app/agrichain360.apk" class="btn btn-o" download><i class="fas fa-download"></i> Android APK</a>
      </div>
    </div>
  </div>

  <div class="card" style="margin-top:20px;background:var(--bg2);border:1px dashed var(--bd)">
    <div style="font-size:.82rem;color:var(--tx2);line-height:1.7">
      <i class="fas fa-lock" style="color:var(--g)"></i>
      <strong>Installing is free and open to everyone.</strong> An account is only needed to trade —
      farmers list produce, buyers place orders — and accounts are free too.
      The Android app and web app connect to the same platform.
    </div>
  </div>
</div>

<script src="/js/install.js"></script>
<script>
(function () {
  var s = window.AgriInstall && window.AgriInstall.state;
  if (!s) return;

  function show(id) { var el = document.getElementById(id); if (el) el.style.display = 'block'; }
  function hide(id) { var el = document.getElementById(id); if (el) el.style.display = 'none'; }

  // Already installed → done state
  if (s.standalone) {
    show('gaInstalled');
    hide('gaChoices');
    return;
  }

  // Reveal the platform-appropriate card
  if (s.platform === 'android') {
    hide('gaIos'); hide('gaDesktop'); hide('gaOther');
  } else if (s.platform === 'ios') {
    hide('gaAndroid'); hide('gaDesktop'); hide('gaOther');
  } else if (s.platform === 'desktop') {
    hide('gaAndroid'); hide('gaIos'); hide('gaOther');
  } else {
    hide('gaAndroid'); hide('gaIos'); hide('gaDesktop');
  }

  // Android: offer the PWA route too when the browser supports it
  var pwaBtn = document.getElementById('gaPwaBtn');
  if (pwaBtn && s.promptAvailable) {
    pwaBtn.style.display = 'inline-flex';
    pwaBtn.addEventListener('click', function () {
      window.AgriInstall.promptNow().catch(function () {
        window.AgriInstall.toast('Your browser does not support one-tap install here. Use the APK download above.');
      });
    });
  }

  // Desktop: native prompt if possible, otherwise manual instructions
  var dBtn = document.getElementById('gaDesktopBtn');
  if (dBtn) {
    if (s.promptAvailable) {
      dBtn.addEventListener('click', function () {
        window.AgriInstall.promptNow().catch(function () {
          document.getElementById('gaDesktopFallback').style.display = 'block';
        });
      });
    } else {
      dBtn.style.display = 'none';
      show('gaDesktopFallback');
    }
  }

  // Older / 32-bit Android: also offer the universal APK
  var fullBtn = document.getElementById('gaApkFull');
  if (fullBtn && s.platform === 'android') {
    var ua = navigator.userAgent || '';
    if (/Android [4-8]\./.test(ua)) { fullBtn.style.display = 'inline-flex'; }
  }

  // React to successful installation
  document.addEventListener('agriinstall:installed', function () {
    show('gaInstalled');
    hide('gaChoices');
  });
})();
</script>

<script>
// This page IS the installation page — suppress the floating PWA prompt.
(function () {
  var hide = function () { var el = document.getElementById('installPrompt'); if (el) el.style.display = 'none'; };
  hide();
  setTimeout(hide, 500); setTimeout(hide, 5500);
  document.addEventListener('DOMContentLoaded', hide);
  window.addEventListener('beforeinstallprompt', function (e) { e.preventDefault(); });
})();
</script>
