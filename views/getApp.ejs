<!-- Get the App — simple: one button, clear instructions -->
<div style="max-width:600px;margin:0 auto;padding:0 4px 40px">

  <div style="text-align:center;padding:8px 0 4px">
    <div style="width:80px;height:80px;border-radius:24px;background:var(--g);display:inline-flex;align-items:center;justify-content:center;box-shadow:var(--sh)">
      <i class="fab fa-android" style="font-size:1.9rem;color:#fff"></i>
    </div>
    <h2 style="font-weight:800;margin:14px 0 6px">Get the AGRICHAIN 360 App</h2>
    <p style="color:var(--tx2);font-size:.95rem;max-width:420px;margin:0 auto">
      Install on your Android phone — <strong style="color:var(--g)">no account needed to install</strong>.
    </p>
  </div>

  <!-- Primary download button -->
  <div style="text-align:center;margin:28px 0 32px">
    <a href="/download/agrichain360-arm64-v1.1.3.apk" download
       class="btn btn-p"
       style="padding:18px 32px;font-size:1.1rem;box-shadow:0 6px 24px rgba(27,94,32,.35)">
      <i class="fas fa-download"></i>
      &nbsp;Download Android App
      <span style="background:rgba(255,255,255,.22);border-radius:9px;padding:3px 10px;font-size:.72rem;font-weight:800;margin-left:8px">29 MB</span>
    </a>
    <div style="font-size:.78rem;color:var(--tx2);margin-top:10px">
      Works on Android 7 and newer
    </div>
  </div>

  <!-- Install instructions -->
  <div class="card" style="background:var(--bg2);border:1px solid var(--bd)">
    <h3 style="font-weight:800;font-size:.9rem;margin-bottom:14px;color:var(--tx)">
      <i class="fas fa-circle-info" style="color:var(--g)"></i>
      &nbsp;How to install
    </h3>
    <div style="display:flex;flex-direction:column;gap:12px">
      <div style="display:flex;gap:12px;align-items:flex-start">
        <div style="width:26px;height:26px;border-radius:9px;background:var(--g);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:.8rem;flex-shrink:0">1</div>
        <div style="font-size:.87rem;color:var(--tx2);line-height:1.5">
          <strong style="color:var(--tx)">Tap the Download button above.</strong>
          The file downloads to your phone (about 29 MB — on mobile data this takes 1–3 minutes).
        </div>
      </div>
      <div style="display:flex;gap:12px;align-items:flex-start">
        <div style="width:26px;height:26px;border-radius:9px;background:var(--g);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:.8rem;flex-shrink:0">2</div>
        <div style="font-size:.87rem;color:var(--tx2);line-height:1.5">
          <strong style="color:var(--tx)">Open the downloaded file.</strong>
          Tap the notification or find it in your Files app. If Android asks "Allow installs from this source?", tap <strong>Allow</strong> or <strong>Install anyway</strong>.
        </div>
      </div>
      <div style="display:flex;gap:12px;align-items:flex-start">
        <div style="width:26px;height:26px;border-radius:9px;background:var(--g);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:.8rem;flex-shrink:0">3</div>
        <div style="font-size:.87rem;color:var(--tx2);line-height:1.5">
          <strong style="color:var(--tx)">Open the app and log in.</strong>
          Use the same phone number and password as the website — your data is identical on both.
        </div>
      </div>
    </div>
  </div>

  <!-- Divider -->
  <div style="display:flex;align-items:center;gap:12px;margin:28px 0">
    <div style="flex:1;height:1px;background:var(--bd)"></div>
    <span style="font-size:.75rem;color:var(--tx2);font-weight:600">OR</span>
    <div style="flex:1;height:1px;background:var(--bd)"></div>
  </div>

  <!-- Web app fallback -->
  <div style="text-align:center">
    <a href="/" class="btn btn-o" style="padding:14px 28px;font-size:.95rem">
      <i class="fas fa-globe"></i>
      &nbsp;Use the Web App instead
    </a>
    <div style="font-size:.75rem;color:var(--tx2);margin-top:8px">
      Everything works in your browser — no download required.
    </div>
  </div>
</div>

<style>
  /* suppress the floating PWA banner on this page */
  #installPrompt { display: none !important; }
</style>
