        </div>
      </div>
    </div>

    <!-- iOS -->
    <div class="card" id="gaIos" style="display:none">
      <div style="display:flex;gap:14px;align-items:flex-start">
        <div style="width:44px;height:44px;border-radius:14px;background:var(--gl);display:flex;align-items:center;justify-content:center;flex-shrink:0">
          <i class="fab fa-apple" style="font-size:1.3rem;color:var(--g)"></i>
