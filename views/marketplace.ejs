<!-- Marketplace — database-backed listings -->
<div style="display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:12px;margin-bottom:20px"> <div> <h2 style="font-weight:800;margin-bottom:4px">Marketplace</h2> <div style="color:var(--tx2);font-size:.9rem"> Verified agricultural produce from registered farmers across the Busoga region
    </div> </div> <a href="/verify" class="btn btn-o btn-sm"><i class="fas fa-certificate"></i> Verify a Passport</a>
</div> <% if (data.success) { %> <div style="background:#e8f5e9;border:1px solid #4caf50;border-radius:10px;padding:12px 16px;margin-bottom:16px;font-size:.85rem;color:#1b5e20"> <i class="fas fa-check-circle"></i> <%= data.success %> </div>
<% } %>
<% if (data.error) { %> <div style="background:#fff3e0;border:1px solid #ff9800;border-radius:10px;padding:12px 16px;margin-bottom:16px;font-size:.85rem;color:#e65100"> <i class="fas fa-exclamation-circle"></i> <%= data.error %> </div>
<% } %> <!-- Summary — only rendered when live data exists -->
<% if (data.stats && data.stats.listings !== undefined && data.stats.listings !== null) { %>
<div class="grid grid3" style="margin-bottom:20px">
  <div class="metric" style="border-left:3px solid var(--g)">
    <div class="metric-val"><%= data.stats.listings %></div>
    <div class="metric-lbl">Active Listings</div>
  </div>
  <div class="metric" style="border-left:3px solid var(--a)">
    <div class="metric-val"><%= (data.stats.total_kg || 0).toLocaleString() %></div>
    <div class="metric-lbl">Kilograms Available</div>
  </div>
  <div class="metric" style="border-left:3px solid var(--g)">
    <div class="metric-val" style="color:var(--g)"><%= data.stats.certified || 0 %></div>
    <div class="metric-lbl">Certified Batches</div>
  </div>
</div>
<% } %> <!-- Filters -->
<div class="card mb20" style="margin-bottom:20px"> <form method="GET" action="/marketplace" style="display:flex;gap:10px;flex-wrap:wrap;align-items:center"> <input type="text" name="q" placeholder="Search crop, district or farmer" value="<%= data.query %>" style="flex:1;min-width:200px"> <select name="crop" style="min-width:140px"> <option value="">All crops</option> <% (data.crops || []).forEach(function(c){ %> <option value="<%= c %>" <%= data.cropFilter === c ? 'selected' : '' %>><%= c %></option> <% }) %> </select> <select name="district" style="min-width:140px"> <option value="">All districts</option> <% (data.districts || []).forEach(function(d){ %> <option value="<%= d %>" <%= data.districtFilter === d ? 'selected' : '' %>><%= d %></option> <% }) %> </select> <button type="submit" class="btn btn-p btn-sm"><i class="fas fa-search"></i> Search</button> <a href="/marketplace" class="btn btn-o btn-sm">Reset</a> </form>
</div> <!-- Listings -->
<div class="card"> <% if (!data.products || data.products.length === 0) { %> <div style="text-align:center;padding:50px 20px"> <i class="fas fa-seedling" style="font-size:2.4rem;color:var(--tx2);opacity:.5"></i> <h3 style="font-weight:800;margin-top:14px">No listings match your search</h3> <p style="color:var(--tx2);font-size:.88rem;max-width:420px;margin:8px auto 16px"> Try a different crop or district, or clear the filters to see everything currently available.
      </p> <a href="/marketplace" class="btn btn-o btn-sm">Clear filters</a> </div> <% } else { %> <div class="tbl-wrap"> <table> <thead> <tr> <th>Crop</th> <th>Quantity</th> <th>Price</th> <th>Quality</th> <th>Moisture</th> <th>Location</th> <th>Farmer</th> <th>Passport</th> <th></th> </tr> </thead> <tbody> <% data.products.forEach(function(p){ %> <tr> <td><strong><%= p.crop %></strong></td> <td><%= parseFloat(p.quantity).toLocaleString() %> <%= p.unit %></td> <td><strong>UGX <%= parseFloat(p.price_per_unit).toLocaleString() %></strong>/<%= p.unit %></td> <td> <% if (p.quality_status === 'APPROVED') { %> <span class="tag tag-g"><i class="fas fa-check"></i> Approved</span> <% } else if (p.quality_status === 'REJECTED') { %> <span class="tag tag-r">Rejected</span> <% } else { %> <span class="tag tag-a">Pending</span> <% } %> <% if (p.quality_grade) { %><span class="tag tag-b">Grade <%= p.quality_grade %></span><% } %> </td> <td><%= p.moisture_level != null ? p.moisture_level + '%' : '—' %></td> <td><%= [p.village, p.district].filter(Boolean).join(', ') || '—' %></td> <td><%= p.farmer_name %></td> <td> <% if (p.batch_number) { %> <a href="/passport/<%= p.batch_number %>" class="btn btn-o btn-sm"><i class="fas fa-certificate"></i> <%= p.batch_number %></a> <% } else { %> <span style="color:var(--tx2);font-size:.8rem">Not yet issued</span> <% } %> </td> <td><a href="/product/<%= p.id %>" class="btn btn-p btn-sm">View</a></td> </tr> <% }) %> </tbody> </table> </div> <% } %>
</div> <style> table{width:100%;border-collapse:collapse;font-size:.85rem}
  thead th{text-align:left;padding:12px 14px;background:var(--bg2);color:var(--tx2);font-weight:700;font-size:.72rem;text-transform:uppercase;letter-spacing:.4px;white-space:nowrap}
  tbody td{padding:12px 14px;border-top:1px solid var(--bd);vertical-align:middle}
  tbody tr:hover{background:var(--bg2)}
</style>
