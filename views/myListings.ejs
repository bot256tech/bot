<!-- My Listings — farmer's own produce -->
<%
  var products = data.products || [];
%>
<div style="display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:12px;margin-bottom:22px"> <div> <h2 style="font-weight:800;margin-bottom:4px">My Listings</h2> <div style="color:var(--tx2);font-size:.9rem">Manage your marketplace listings and their quality records</div> </div> <a href="/farmer-dashboard" class="btn btn-o btn-sm"><i class="fas fa-arrow-left"></i> Dashboard</a>
</div> <% if (data.error) { %> <div style="background:#fff3e0;border:1px solid #ff9800;border-radius:10px;padding:12px 16px;margin-bottom:16px;font-size:.85rem;color:#e65100"><%= data.error %></div>
<% } %> <div class="card"> <% if (products.length === 0) { %> <div style="text-align:center;padding:44px 20px"> <i class="fas fa-store" style="font-size:2rem;color:var(--tx2);opacity:.5"></i> <h3 style="font-weight:800;margin-top:12px">No listings yet</h3> <p style="color:var(--tx2);font-size:.86rem;margin:6px 0 14px">Register produce from your Farmer Dashboard to list it on the marketplace.</p> <a href="/farmer-dashboard" class="btn btn-p btn-sm">Register Produce</a> </div> <% } else { %> <div class="tbl-wrap"> <table> <thead><tr><th>Crop</th><th>Quantity</th><th>Price</th><th>Quality</th><th>Passport</th><th>Marketplace</th><th></th></tr></thead> <tbody> <% products.forEach(function(p){ %> <tr> <td><strong><%= p.crop %></strong></td> <td><%= parseFloat(p.quantity).toLocaleString() %> <%= p.unit %></td> <td>UGX <%= parseFloat(p.price_per_unit).toLocaleString() %>/<%= p.unit %></td> <td> <% if (p.quality_status === 'APPROVED') { %><span class="tag tag-g">Approved</span> <% } else if (p.quality_status === 'REJECTED') { %><span class="tag tag-r">Rejected</span> <% } else { %><span class="tag tag-a">Pending</span><% } %> <% if (p.passport && p.passport.quality_grade) { %><span class="tag tag-b">Grade <%= p.passport.quality_grade %></span><% } %> </td> <td> <% if (p.passport && p.passport.batch_number) { %> <a href="/passport/<%= p.passport.batch_number %>" class="btn btn-o btn-sm"><%= p.passport.batch_number %></a> <% } else { %><span style="color:var(--tx2);font-size:.78rem">Not issued</span><% } %> </td> <td><%= p.available ? 'Listed' : 'Unlisted' %></td> <td> <form method="POST" action="/my-listings/<%= p.id %>/availability"> <button type="submit" class="btn <%= p.available ? 'btn-o' : 'btn-p' %> btn-sm"> <%= p.available ? 'Remove from marketplace' : 'Re-list' %> </button> </form> </td> </tr> <% }) %> </tbody> </table> </div> <% } %>
</div> <style> table{width:100%;border-collapse:collapse;font-size:.84rem}
  thead th{text-align:left;padding:10px 12px;background:var(--bg2);color:var(--tx2);font-weight:700;font-size:.7rem;text-transform:uppercase;letter-spacing:.4px;white-space:nowrap}
  tbody td{padding:10px 12px;border-top:1px solid var(--bd);vertical-align:middle}
  tbody tr:hover{background:var(--bg2)}
</style>
