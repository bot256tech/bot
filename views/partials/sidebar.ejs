<aside class="sidebar" id="sidebar">
  <div class="side-brand"><i class="fas fa-leaf" style="color:var(--g)"></i> AGRICHAIN <span style="color:var(--a)">360</span><sup style="font-size:.55rem">TM</sup></div>
  <nav class="side-nav">
    <div class="nav-section">Platform</div>
    <a href="/" class="nav-item <%= page === 'landing' || page === 'landingPage' || page === 'bootstrapLanding' ? 'active' : '' %>"><i class="fas fa-home"></i> Home</a>
    <a href="/marketplace" class="nav-item <%= page === 'marketplace' || page === 'productDetail' ? 'active' : '' %>"><i class="fas fa-store"></i> Marketplace</a>
    <a href="/verify" class="nav-item <%= page === 'verify' || page === 'passport' ? 'active' : '' %>"><i class="fas fa-certificate"></i> Verify Passport</a>
    <a href="/ai-advisor" class="nav-item <%= page === 'ai-advisor' ? 'active' : '' %>"><i class="fas fa-robot"></i> Decision Advisor</a>

    <% var u = typeof user !== 'undefined' ? user : null; var role = u ? (u.role || '').toUpperCase() : ''; %>
    <% if (u) { %>
      <div class="nav-section">My Account</div>
      <% if (role === 'FARMER') { %>
        <a href="/farmer-dashboard" class="nav-item <%= page === 'farmer-dashboard' ? 'active' : '' %>"><i class="fas fa-tractor"></i> Farmer Dashboard</a>
        <a href="/my-listings" class="nav-item <%= page === 'my-listings' ? 'active' : '' %>"><i class="fas fa-list"></i> My Listings</a>
      <% } else if (role === 'BUYER') { %>
        <a href="/buyer-dashboard" class="nav-item <%= page === 'buyer-dashboard' ? 'active' : '' %>"><i class="fas fa-shopping-basket"></i> Buyer Dashboard</a>
        <a href="/order-history" class="nav-item <%= page === 'order-history' ? 'active' : '' %>"><i class="fas fa-receipt"></i> Order History</a>
      <% } else if (role === 'ADMIN') { %>
        <a href="/admin-dashboard" class="nav-item <%= page === 'admin-dashboard' ? 'active' : '' %>"><i class="fas fa-chart-line"></i> Admin Dashboard</a>
      <% } else { %>
        <a href="/marketplace" class="nav-item"><i class="fas fa-th-large"></i> Browse & Transact</a>
      <% } %>
      <a href="/logout" class="nav-item"><i class="fas fa-sign-out-alt"></i> Log Out</a>
    <% } else { %>
      <div class="nav-section">Get Started</div>
      <a href="/login" class="nav-item <%= page === 'login' ? 'active' : '' %>"><i class="fas fa-sign-in-alt"></i> Log In</a>
      <a href="/signup" class="nav-item <%= page === 'signup' || page === 'roles' ? 'active' : '' %>"><i class="fas fa-user-plus"></i> Create Account</a>
    <% } %>

    <div class="nav-section">Information</div>
    <a href="/pricing" class="nav-item <%= page === 'pricing' ? 'active' : '' %>"><i class="fas fa-coins"></i> Pricing & Fees</a>
    <a href="/app/agrichain360.apk" class="nav-item"><i class="fab fa-android"></i> Android App (APK)</a>
  </nav>
  <div style="padding:16px;border-top:1px solid var(--bd);margin-top:auto">
    <button class="btn btn-o btn-sm" onclick="toggleTheme()" style="width:100%;justify-content:center">
      <span class="sun-icon">☀</span><span class="moon-icon">☾</span> Dark/Light Mode
    </button>
    <div style="margin-top:10px;font-size:.68rem;color:var(--tx2);text-align:center">
      AGRICHAIN 360 — Busoga Region Pilot<br>Mayuge · Bugiri · Iganga · Jinja · Kamuli
    </div>
  </div>
</aside>
