<!-- Product Detail -->
<%
  var p = data.product;
  var pass = data.passport;
  var user = data.user;
  var isBuyer = user && (user.role || '').toUpperCase() === 'BUYER';
  var isDemo = p.record_source === 'demo' || (pass && pass.record_source === 'demo');
%> <div style="margin-bottom:20px"> <a href="/marketplace" class="btn btn-o btn-sm"><i class="fas fa-arrow-left"></i> Back to Marketplace</a>
</div> <div class="grid grid2"> <!-- Listing --> <div class="card"> <div style="display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:10px"> <div> <h2 style="font-weight:800;margin-bottom:4px"><%= p.crop %></h2> <div style="color:var(--tx2);font-size:.88rem"> Listed by <strong><%= p.farmer_name %></strong> — <%= [p.village, p.district].filter(Boolean).join(', ') %> </div> </div> <% if (p.quality_status === 'APPROVED') { %> <span class="tag tag-g">Quality Approved</span> <% } else if (p.quality_status === 'REJECTED') { %> <span class="tag tag-r">Quality Rejected</span> <% } else { %> <span class="tag tag-a">Quality Pending</span> <% } %> </div> <div class="grid grid3" style="margin-top:20px;gap:12px"> <div class="metric" style="padding:14px"> <div class="metric-val" style="font-size:1.3rem"><%= parseFloat(p.quantity).toLocaleString() %></div> <div class="metric-lbl"><%= p.unit %> available</div> </div> <div class="metric" style="padding:14px"> <div class="metric-val" style="font-size:1.3rem">UGX <%= parseFloat(p.price_per_unit).toLocaleString() %></div> <div class="metric-lbl">per <%= p.unit %></div> </div> <div class="metric" style="padding:14px"> <div class="metric-val" style="font-size:1.3rem">UGX <%= Math.round(parseFloat(p.quantity) * parseFloat(p.price_per_unit)).toLocaleString() %></div> <div class="metric-lbl">full-batch value</div> </div> </div> <% if (isDemo) { %> <div style="margin-top:18px;background:#e3f2fd;border:1px solid #90caf9;border-radius:10px;padding:10px 14px;font-size:.78rem;color:#0d47a1"> <i class="fas fa-info-circle"></i> <strong>Demonstration record</strong> — this listing is seeded sample data for the platform showcase.
      </div> <% } %> </div> <!-- Quality passport --> <div class="card"> <h3 style="font-weight:800;margin-bottom:14px"><i class="fas fa-certificate" style="color:var(--g)"></i> Digital Quality Passport</h3> <% if (pass) { %> <table style="width:100%;font-size:.86rem;border-collapse:collapse"> <tr><td style="padding:8px 0;color:var(--tx2)">Batch number</td><td style="padding:8px 0;text-align:right"><strong><%= pass.batch_number %></strong></td></tr> <tr><td style="padding:8px 0;color:var(--tx2)">Quality grade</td><td style="padding:8px 0;text-align:right"> <% if (pass.quality_grade === 'A' || pass.quality_grade === 'B') { %><span class="tag tag-g">Grade <%= pass.quality_grade %></span><% }
             else if (pass.quality_grade === 'REJECTED') { %><span class="tag tag-r">Rejected</span><% }
             else { %><span class="tag tag-a"><%= pass.quality_grade || 'Pending' %></span><% } %> </td></tr> <tr><td style="padding:8px 0;color:var(--tx2)">Moisture content</td><td style="padding:8px 0;text-align:right"><strong><%= pass.moisture_level != null ? pass.moisture_level + '%' : 'Not recorded' %></strong></td></tr> <tr><td style="padding:8px 0;color:var(--tx2)">Aflatoxin result</td><td style="padding:8px 0;text-align:right"><strong><%= pass.aflatoxin_result != null ? pass.aflatoxin_result + ' ppb' : 'Not recorded' %></strong></td></tr> <tr><td style="padding:8px 0;color:var(--tx2)">Quantity covered</td><td style="padding:8px 0;text-align:right"><%= parseFloat(pass.quantity).toLocaleString() %> <%= p.unit %></td></tr> <tr><td style="padding:8px 0;color:var(--tx2)">Record source</td><td style="padding:8px 0;text-align:right"> <% if (pass.record_source === 'demo') { %><span class="tag tag-b">Demonstration data</span> <% } else if (pass.record_source === 'partner') { %><span class="tag tag-g">Partner-entered</span> <% } else { %><span class="tag tag-g">Farmer-entered</span><% } %> </td></tr> <tr><td style="padding:8px 0;color:var(--tx2)">Verification status</td><td style="padding:8px 0;text-align:right"> <% if (pass.verified_at) { %><span class="tag tag-g">Verified</span><% } else { %><span class="tag tag-a">Pending verification</span><% } %> </td></tr> </table> <a href="/passport/<%= pass.batch_number %>" class="btn btn-p" style="width:100%;justify-content:center;margin-top:16px"> <i class="fas fa-qrcode"></i> Open Verifiable Passport
      </a> <% } else { %> <div style="text-align:center;padding:30px 10px"> <i class="fas fa-hourglass-half" style="font-size:1.8rem;color:var(--tx2);opacity:.5"></i> <p style="color:var(--tx2);font-size:.86rem;margin-top:10px"> A Digital Quality Passport has not been issued for this crop yet.
          Moisture and test results will appear here once recorded by the farmer or a testing partner.
        </p> </div> <% } %> </div>
</div> <!-- Order panel -->
<div class="card" style="margin-top:20px"> <h3 style="font-weight:800;margin-bottom:12px"><i class="fas fa-shopping-cart" style="color:var(--g)"></i> Place an Order Request</h3> <% if (isBuyer) { %> <% if (p.available) { %> <form method="POST" action="/orders" style="display:flex;gap:12px;flex-wrap:wrap;align-items:flex-end"> <input type="hidden" name="product_id" value="<%= p.id %>"> <input type="hidden" name="back" value="/product/<%= p.id %>"> <div> <label style="display:block;font-size:.78rem;font-weight:700;color:var(--tx2);margin-bottom:6px">Quantity (<%= p.unit %>)</label> <input type="number" name="quantity" min="1" step="1" max="<%= parseFloat(p.quantity) %>" value="1" required style="width:140px"> </div> <button type="submit" class="btn btn-p"><i class="fas fa-paper-plane"></i> Request Order</button> <div style="font-size:.78rem;color:var(--tx2)"> The farmer receives your request with your contact details. Payment is settled via mobile money or bank transfer on confirmation.
        </div> </form> <% } else { %> <p style="color:var(--tx2);font-size:.88rem">This listing is currently unavailable.</p> <% } %> <% } else if (user) { %> <p style="color:var(--tx2);font-size:.88rem"> You are signed in as <strong><%= user.role %></strong>. Order requests are placed by buyer accounts.
    </p> <% } else { %> <p style="color:var(--tx2);font-size:.88rem"> <a href="/login?redirect=/product/<%= p.id %>" style="font-weight:700">Log in</a> or
      <a href="/signup?role=buyer" style="font-weight:700">create a buyer account</a> to place an order request.
    </p> <% } %>
</div> <style> input[type=number]{padding:10px 14px;border:1px solid var(--bd);border-radius:50px;font-size:.85rem;background:var(--bg);color:var(--tx);outline:none}
</style>
