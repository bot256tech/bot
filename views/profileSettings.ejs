<div style="max-width:520px;margin:0 auto;padding:0 4px">
  <h2 style="font-weight:800;margin-bottom:4px">Profile &amp; Account</h2>
  <p style="color:var(--tx2);font-size:.9rem;margin-bottom:20px">Manage your account settings</p>

  <div class="card" style="margin-bottom:16px">
    <h3 style="font-weight:800;font-size:.9rem;margin-bottom:12px">Your Information</h3>
    <div style="font-size:.85rem;line-height:2">
      <div><strong>Name:</strong> <%= data.user.name %></div>
      <div><strong>Phone:</strong> <%= data.user.phone %></div>
      <div><strong>Role:</strong> <%= data.user.role %></div>
    </div>
  </div>

  <div class="card" style="border:1px solid #FFCDD2">
    <h3 style="font-weight:800;font-size:.9rem;margin-bottom:8px;color:#c62828">
      <i class="fas fa-exclamation-triangle"></i> Danger Zone
    </h3>
    <p style="font-size:.82rem;color:var(--tx2);line-height:1.5;margin-bottom:14px">
      Deleting your account permanently removes:
    </p>
    <ul style="font-size:.8rem;color:var(--tx2);padding-left:18px;margin-bottom:16px;line-height:1.7">
      <li>Your account and profile</li>
      <li>All your produce listings</li>
      <li>All your quality passports</li>
      <li>All your orders and bookings</li>
    </ul>
    <p style="font-size:.82rem;color:var(--tx2);margin-bottom:14px">This action cannot be undone.</p>

    <% if (data.error) { %>
    <div style="background:#ffebee;border:1px solid #ef5350;border-radius:8px;padding:10px;margin-bottom:12px;font-size:.8rem;color:#c62828">
      <%= data.error %>
    </div>
    <% } %>

    <form method="POST" action="/account/delete"
          onsubmit="return confirm('Are you absolutely sure?\\n\\nThis permanently deletes your account and ALL associated data.\\nThis cannot be undone.')">
      <div style="margin-bottom:12px">
        <label style="display:block;margin-bottom:6px;font-weight:600;font-size:.82rem">Enter your password to confirm</label>
        <input type="password" name="password" required placeholder="Your password"
               style="width:100%;padding:12px;border:1px solid var(--bd);border-radius:10px;font-size:.9rem;background:var(--bg);color:var(--tx)">
      </div>
      <button type="submit" class="btn btn-o" style="width:100%;color:#c62828;border-color:#ef5350;justify-content:center">
        <i class="fas fa-trash"></i> Delete My Account Permanently
      </button>
    </form>
  </div>
</div>
